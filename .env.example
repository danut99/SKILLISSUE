# Copy to .env and fill in from Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-SUPABASE-PUBLISHABLE-KEY

# Optional: override the Microsoft Clarity project id from src/config.ts (empty value disables it).
# VITE_CLARITY_PROJECT_ID=zcwstocts6
